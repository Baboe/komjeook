# Publieke Supabase-gegevens (de anon key mag in de client; RLS doet de echte
# afscherming). Zet hier NOOIT de service_role key in.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Alleen voor lokaal testen; werkt uitsluitend in development-builds (__DEV__).
EXPO_PUBLIC_DEV_SKIP_AUTH=false
